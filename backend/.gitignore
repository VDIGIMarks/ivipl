# ==============================================================================
# Node.js & Express Backend .gitignore
# ==============================================================================

# Dependencies
node_modules/
jspm_packages/

# Environment Variables & Secrets (Keep your DB credentials & API keys safe)
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test
!.env.example

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime data & Temporary files
pids
*.pid
*.seed
*.pid.lock
uploads/
temp/
tmp/

# Testing & Coverage
coverage/
.nyc_output/

# Build & Dist outputs
dist/
build/

# IDE & Editor Settings
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
