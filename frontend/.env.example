# Frontend Environment Variables

# In development, Vite connects to local backend:
# VITE_API_URL=http://localhost:5000

# When hosting frontend on Hostinger:
# If your backend is hosted separately (e.g. https://api.yourdomain.com or on Render/Railway/VPS):
# VITE_API_URL=https://api.yourdomain.com

# If your backend is hosted on the same domain/proxy, leave empty:
# VITE_API_URL=
