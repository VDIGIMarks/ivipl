# ======================================================================
# IVIPL Real Estate - Production .htaccess for Hostinger
# Optimized for Hostinger LiteSpeed & Apache Servers
# ======================================================================

# ----------------------------------------------------------------------
# 1. SECURITY & DIRECTORY SETTINGS
# ----------------------------------------------------------------------
# Disable directory browsing (prevents users from listing files)
Options -Indexes

# Follow Symbolic Links
Options +FollowSymLinks

# Set default character set
AddDefaultCharset UTF-8

# ----------------------------------------------------------------------
# 2. SECURITY HEADERS
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
    # Prevent MIME type sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Prevent clickjacking attacks (only allow embedding from same origin)
    Header always set X-Frame-Options "SAMEORIGIN"

    # Cross-site scripting (XSS) filter
    Header always set X-XSS-Protection "1; mode=block"

    # Referrer policy for privacy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ----------------------------------------------------------------------
# 3. BLOCK SENSITIVE FILES
# ----------------------------------------------------------------------
<FilesMatch "^\.|\.(env|json|lock|config|md|yml|yaml|bak|log|sql)$">
    <IfModule authz_core_module>
        Require all denied
    </IfModule>
    <IfModule !authz_core_module>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Allow public web manifests and browser XMLs
<FilesMatch "(manifest\.json|browserconfig\.xml)$">
    <IfModule authz_core_module>
        Require all granted
    </IfModule>
    <IfModule !authz_core_module>
        Order allow,deny
        Allow from all
    </IfModule>
</FilesMatch>

# ----------------------------------------------------------------------
# 4. GZIP / DEFLATE COMPRESSION (Speed Optimization)
# ----------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/ttf
    AddOutputFilterByType DEFLATE font/otf
    AddOutputFilterByType DEFLATE font/woff
    AddOutputFilterByType DEFLATE font/woff2
</IfModule>

# ----------------------------------------------------------------------
# 5. BROWSER CACHING (Fast Repeat Visits)
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On

    # Images & Media (1 Year)
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType video/mp4 "access plus 1 year"
    ExpiresByType video/webm "access plus 1 year"

    # Fonts (1 Year)
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"

    # Bundled CSS & JavaScript (Hashed filenames by Vite - 1 Year)
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"

    # HTML (Never cache HTML so updates are immediate on reload)
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Ensure index.html always gets revalidated by browser
<FilesMatch "\.(html)$">
    <IfModule mod_headers.c>
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires 0
    </IfModule>
</FilesMatch>

# ----------------------------------------------------------------------
# 6. URL REWRITING & ROUTING (Vite + React Router SPA)
# ----------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 6A. Force HTTPS (SSL) Redirect on Hostinger
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # 6B. Optional: API Reverse Proxy
    # If your Node.js backend is hosted on Hostinger VPS or running on port 5000,
    # you can uncomment the next 2 lines to proxy /api requests to localhost:5000:
    # RewriteCond %{REQUEST_URI} ^/api/(.*)$
    # RewriteRule ^api/(.*)$ http://127.0.0.1:5000/api/$1 [P,L]

    # 6C. React SPA Fallback:
    # If the requested physical file or folder exists, serve directly:
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Otherwise, route all URLs to index.html (solves 404 error on page refresh)
    RewriteRule ^ index.html [L]
</IfModule>

# ----------------------------------------------------------------------
# 7. CUSTOM ERROR PAGES FALLBACK
# ----------------------------------------------------------------------
ErrorDocument 404 /index.html
